#version 450

// Biquad IIR blocked-scan, pass 3/3: final pass with exact initial states.
//
// Each thread re-runs its block using the true initial state computed by
// pass 2 and writes the filtered samples. The input history (x[n-1], x[n-2])
// at the block boundary is read directly from the input array.
//
// Layout: input/output [channel][sample].
// Dispatch: grid = (ceil(K/128), C, 1), local = (128, 1, 1).

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer InBuffer { float inbuf[]; };
layout(std430, binding = 1) readonly buffer StateBuffer { float state[]; };
layout(std430, binding = 2) writeonly buffer OutBuffer { float outbuf[]; };

layout(push_constant) uniform Params {
    int N;   // samples per channel
    int L;   // nominal block length
    int C;   // channels
    int K;   // blocks per channel
    float b0;
    float b1;
    float b2;
    float a1;
    float a2;
} params;

void main() {
    const int k = int(gl_GlobalInvocationID.x);
    const int c = int(gl_GlobalInvocationID.y);
    if (k >= params.K || c >= params.C) return;

    const int start = k * params.L;
    const int end = min(start + params.L, params.N);
    const int base = c * params.N;

    const int idx = (c * params.K + k) * 2;
    float y1 = state[idx];
    float y2 = state[idx + 1];
    float x1 = (start >= 1) ? inbuf[base + start - 1] : 0.0f;
    float x2 = (start >= 2) ? inbuf[base + start - 2] : 0.0f;

    for (int n = start; n < end; ++n) {
        const float x0 = inbuf[base + n];
        const float y0 = params.b0 * x0 + params.b1 * x1 + params.b2 * x2
                       - params.a1 * y1 - params.a2 * y2;
        outbuf[base + n] = y0;
        x2 = x1; x1 = x0;
        y2 = y1; y1 = y0;
    }
}
